#include <mcs51/8051.h>

// Hexadecimal 0-F lookup table stored in code memory (ROM)
__code const unsigned char hex_seg_lut[16] = {
    0x3F, // 0
    0x06, // 1
    0x5B, // 2
    0x4F, // 3
    0x66, // 4
    0x6D, // 5
    0x7D, // 6
    0x07, // 7
    0x7F, // 8
    0x6F, // 9
    0x77, // A
    0x7C, // b
    0x39, // C
    0x5E, // d
    0x79, // E
    0x71  // F
};

void main(void) {
    unsigned char hex_input;

    while (1) {
        // Step 1: Configure Port 0 as input
        P0 = 0xFF;

        // Step 2: Read 4-bit binary input from lower nibble (P0.0 to P0.3)
        hex_input = P0 & 0x0F;

        // Step 3: Map input to 7-segment pattern and output to Port 1
        P1 = hex_seg_lut[hex_input];
    }
}