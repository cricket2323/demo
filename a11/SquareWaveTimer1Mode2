#include <mcs51/8051.h>

void main(void) {
    // Configure Timer 1 in Mode 2 (8-bit Auto-Reload, Timer mode)
    TMOD = 0x20;

    // Load reload value: 256 - 250 = 6 (0x06) for 250 us half-period
    TH1 = 0x06;
    TL1 = 0x06;

    // Clear overflow flag and start Timer 1
    TF1 = 0;
    TR1 = 1;

    while (1) {
        // Wait for Timer 1 to overflow (TF1 goes HIGH every 250 us)
        while (!TF1);

        // Clear overflow flag (hardware does not auto-clear TF1 in polling mode)
        TF1 = 0;

        // Toggle output pin on Port 2 (e.g., P2.0)
        P2_0 = !P2_0;
    }
}