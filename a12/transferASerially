#include <mcs51/8051.h>

void uart_init(void) {
    TMOD = 0x20;      // Timer 1 in Mode 2 (8-bit auto-reload)
    TH1  = 0xFA;      // Reload value for 4800 baud with 11.0592 MHz crystal
    TL1  = 0xFA;      // Initial timer value
    TR1  = 1;         // Start Timer 1
    SCON = 0x50;      // Mode 1: 8-bit UART, 1 stop bit, REN enabled
}

void uart_tx_char(unsigned char ch) {
    SBUF = ch;        // Put character into serial buffer to start transmission
    while (!TI);      // Wait until transmission completes (TI goes HIGH)
    TI = 0;           // Clear transmit flag for the next byte
}

void main(void) {
    uart_init();

    while (1) {
        uart_tx_char('A'); // Continuously transmit 'A'
    }
}