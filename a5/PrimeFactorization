ORG 0000H

    MOV DPTR, #5000H
    MOVX A, @DPTR
    MOV R0, A

    MOV R1, #02H

FACTOR_LOOP:
    CJNE R0, #01H, DIV_TEST
    SJMP DONE

DIV_TEST:
    MOV A, R0
    MOV B, R1
    DIV AB

    MOV R2, A
    MOV A, B
    JNZ NEXT_DIVISOR

    MOV A, R2
    MOV R0, A

    INC DPTR
    MOV A, R1
    MOVX @DPTR, A
    SJMP FACTOR_LOOP

NEXT_DIVISOR:
    INC R1
    SJMP FACTOR_LOOP

DONE:
    SJMP DONE

    END