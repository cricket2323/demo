ORG 0000H

    MOV R2, #05H

OUTER_LOOP:
    MOV DPTR, #2050H
    MOV R3, #05H

INNER_LOOP:
    MOVX A, @DPTR
    MOV R0, A
    INC DPTR
    MOVX A, @DPTR
    MOV B, A

    MOV A, R0
    CJNE A, B, CHECK_SWAP
    SJMP NO_SWAP

CHECK_SWAP:
    JC NO_SWAP

    MOV A, R0
    MOVX @DPTR, A
    DEC DPL
    MOV A, B
    MOVX @DPTR, A
    INC DPL

NO_SWAP:
    DJNZ R3, INNER_LOOP
    DJNZ R2, OUTER_LOOP

HERE:
    SJMP HERE

    END